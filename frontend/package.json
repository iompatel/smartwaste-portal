{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve frontend",
    "start:admin": "ng serve admin --port 4300",
    "start:worker": "ng serve worker --port 4400",
    "build": "node scripts/generate-runtime-config.mjs && ng build frontend",
    "build:admin": "node scripts/generate-runtime-config.mjs && ng build admin",
    "build:worker": "node scripts/generate-runtime-config.mjs && ng build worker",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/fire": "20.1.1",
    "@angular/forms": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@angular/platform-browser-dynamic": "20.3.35",
    "@angular/router": "20.3.35",
    "animejs": "^4.5.0",
    "firebase": "13.2.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "motion": "^14.12.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.17",
    "@angular/cli": "^20.3.17",
    "@angular/compiler-cli": "20.3.35",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}

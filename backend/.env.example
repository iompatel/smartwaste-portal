# Required. Generate a strong random string (e.g., openssl rand -hex 32).
JWT_SECRET=your-jwt-secret-here

MONGO_URI=mongodb://127.0.0.1:27017/smart_waste_portal

# Local development serves both portals. Production uses separate public/admin backend services.
SERVICE_MODE=combined

# Exact browser origins allowed to call the API (comma-separated values are accepted).
PUBLIC_FRONTEND_URL=http://localhost:4200
ADMIN_FRONTEND_URL=http://localhost:4300

# One-time admin bootstrap. Remove SEED_ADMIN_PASSWORD after the first successful startup.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_SESSION_TTL_MINUTES=30

# Production hard-security mode: verify Cloudflare Access at the admin backend origin.
# REQUIRE_CF_ACCESS=true
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-audience-tag

# Demo worker/user accounts are development-only by default.
SEED_DEMO_USERS=false

# Firebase Admin: provide EITHER the JSON string or base64 (preferred for Render),
# or a path to a service account file. Do not commit the file to git.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=...
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
